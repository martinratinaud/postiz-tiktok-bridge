# Docker volume holding Postiz uploads (docker volume ls | grep uploads)
POSTIZ_UPLOADS_VOLUME=postiz_postiz-uploads
# Docker network shared with the Postiz Postgres container
POSTIZ_NETWORK=postiz_default
# Postiz database, reachable from that network (same value as Postiz's DATABASE_URL)
POSTIZ_DATABASE_URL=postgresql://user:password@postgres:5432/postiz
# Saved autotok account used for every TikTok post
AUTOTOK_ACCOUNT=default
# Posts scheduled before this date are never touched (set it to the install time)
BRIDGE_SINCE=2026-01-01T00:00:00Z
# Optional: only these Postiz TikTok integration ids (comma-separated); empty = all
BRIDGE_INTEGRATION_IDS=
# Link written in Postiz once published
TIKTOK_PROFILE_URL=https://www.tiktok.com/@your_handle
BRIDGE_POLL_SECONDS=60
BRIDGE_GRACE_SECONDS=180
BRIDGE_DRY_RUN=0
LOGIN_PORT=3010
